NODE_ENV=development
DATA_SOURCE=mock
DATABASE_URL=postgresql://dashboard_user:CHANGE_ME@localhost:5432/n8n
DB_SSL=false
APP_TIME_ZONE=Asia/Bangkok
AUTH_USER=admin
AUTH_PASSWORD=replace-with-a-long-unique-password
AUTH_ENABLED=true
DOMAIN_NAME=example.com
DASHBOARD_HOST=news.example.com
APP_ORIGIN=http://localhost:3000
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v27.0
DASHBOARD_BASE_PATH=/news
PORT=3000
HOSTNAME=0.0.0.0
TRAEFIK_ENABLED=true
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true
TRAEFIK_CERTRESOLVER=mytlschallenge
TRAEFIK_PRIORITY=100
DOCKER_NETWORK_NAME=n8n-compose_default
DASHBOARD_CONTAINER_NAME=gaming-dashboard
